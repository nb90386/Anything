# ─────────────────────────────────────────────────────────────────────────
# Malbek Contract Intelligence Copilot — environment configuration
# Copy this file to .env.local and fill in only what you need.
# The app runs fully out-of-the-box with ZERO env vars using local SQLite
# and a deterministic mock AI provider — nothing below is required for demo.
# ─────────────────────────────────────────────────────────────────────────

# --- Database -----------------------------------------------------------
# Defaults to a local SQLite file at ./data/clm.db. No setup required.
# To use a hosted Postgres/Supabase database instead, set DB_DRIVER=postgres
# and provide DATABASE_URL (not implemented in this demo build — SQLite only).
# DB_DRIVER=sqlite
# DATABASE_URL=

# --- AI provider ----------------------------------------------------------
# AI_PROVIDER controls which engine powers summaries, risk extraction,
# clause classification, obligation extraction, and the contract chat.
#   "mock"      (default) — deterministic, offline, no API key needed.
#   "anthropic" — uses the Claude API (requires ANTHROPIC_API_KEY).
#   "openai"    — uses the OpenAI API (requires OPENAI_API_KEY).
# See src/lib/ai/provider.ts for the provider interface.
AI_PROVIDER=mock

# Only needed if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Only needed if AI_PROVIDER=openai
OPENAI_API_KEY=

# Optional: OpenRouter as a drop-in multi-model gateway (OpenAI-compatible).
# Only needed if AI_PROVIDER=openai and you point OPENAI_BASE_URL at OpenRouter.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- App ------------------------------------------------------------------
# Seeds a "walkthrough" demo user/session with sample data pre-loaded.
NEXT_PUBLIC_DEMO_MODE=true
