# ----------------------------------------------------------------------------
# PolyAlpha Lab — environment configuration
# Research tool only. Paper trading only. Not financial advice.
# ----------------------------------------------------------------------------

# Database driver: "sqlite" (default, zero-config local file) or "postgres".
DB_DRIVER=sqlite

# SQLite file path (used when DB_DRIVER=sqlite). Defaults to ./data/polyalpha.db
SQLITE_PATH=./data/polyalpha.db

# Postgres / Supabase connection string (used when DB_DRIVER=postgres).
# Example: postgres://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=

# Secret required to invoke cron / control endpoints (Bearer token).
# Generate a long random string. Vercel Cron should send this in the header.
CRON_SECRET=change-me-to-a-long-random-secret

# Polymarket public API hosts (override only if they change).
POLY_GAMMA_BASE=https://gamma-api.polymarket.com
POLY_CLOB_BASE=https://clob.polymarket.com
POLY_DATA_BASE=https://data-api.polymarket.com

# Starting paper bankroll (USD, paper money only).
STARTING_BANKROLL=10000

# When true, ingestion that cannot reach Polymarket will fall back to a clearly
# labeled SAMPLE dataset so the dashboard is not empty in offline/dev environments.
ALLOW_SAMPLE_FALLBACK=true

# Optional: Sentry DSN for error reporting (no-op if empty).
SENTRY_DSN=
